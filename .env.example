# DeepSeek official cloud API, OpenAI-compatible.
DEEPSEEK_API_KEY=sk-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Project LLM settings.
HUATAI_LLM_PROVIDER=deepseek
HUATAI_LLM_API_KEY=sk-your-key
HUATAI_LLM_BASE_URL=https://api.deepseek.com
HUATAI_LLM_MODEL=deepseek-v4-pro
HUATAI_LLM_TIMEOUT_SECONDS=60
HUATAI_LLM_MAX_TOKENS=8192
HUATAI_LLM_TEMPERATURE=0
HUATAI_LLM_MAX_TOKENS=4096

# Local OpenAI-compatible LLM gateway example.
# HUATAI_LLM_PROVIDER=local_openai_compatible
# HUATAI_LLM_BASE_URL=http://127.0.0.1:8000/v1
# HUATAI_LLM_MODEL=deepseek-v4-rpo
# HUATAI_LLM_API_KEY=local-llm-key

# Metadata embedding settings. The default provider is hashing fallback.
HUATAI_EMBEDDING_PROVIDER=hashing
HUATAI_EMBEDDING_MODEL=BAAI/bge-m3
HUATAI_EMBEDDING_VECTOR_SIZE=384
HUATAI_EMBEDDING_NORMALIZE=true

# Local bge-m3 / OpenAI-compatible embedding service example.
# HUATAI_EMBEDDING_PROVIDER=local_openai_compatible
# HUATAI_EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
# HUATAI_EMBEDDING_MODEL=BAAI/bge-m3
# HUATAI_EMBEDDING_API_KEY=local-embedding-key
# HUATAI_EMBEDDING_VECTOR_SIZE=1024

# Metadata Cross-Encoder reranker. Set provider=disabled for RRF-only retrieval.
HUATAI_RERANKER_PROVIDER=cross-encoder
HUATAI_RERANKER_MODEL=BAAI/bge-reranker-base
HUATAI_RERANKER_BATCH_SIZE=8
HUATAI_RERANKER_MAX_LENGTH=512
HUATAI_RERANKER_DEVICE=cpu
HUATAI_RERANKER_FAIL_OPEN=true
